+// Exact Nemotron/Tekken split for the pinned HF regex. Other pretypes do not call this path.
+// General category membership is generated from the same pinned Oniguruma tokenizer.
+#pragma once
+#include "unicode.h"
+#include "unicode-tekken-data.h"
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <vector>
+
+static uint8_t unicode_tekken_flags(uint32_t cp) {
+    const auto begin = unicode_tekken_ranges;
+    const auto end = begin + sizeof(unicode_tekken_ranges) / sizeof(unicode_tekken_ranges[0]);
+    auto it = std::upper_bound(begin, end, cp,
+        [](uint32_t value, const unicode_tekken_range & range) { return value < range.first; });
+    if (it == begin) {
+        return 0;
+    }
+    --it;
+    return cp < it->end ? it->flags : 0;
+}
+
+static std::vector<size_t> unicode_regex_split_custom_tekken(
+        const std::string & text, const std::vector<size_t> & offsets) {
+    const auto cpts = unicode_cpts_from_utf8(text);
+    std::vector<uint8_t> flags;
+    flags.reserve(cpts.size());
+    for (auto cp : cpts) {
+        flags.push_back(unicode_tekken_flags(cp));
+    }
+    std::vector<size_t> result;
+    size_t start = 0;
+    for (auto offset : offsets) {
+        const size_t limit = start + offset;
+        assert(limit <= cpts.size());
+        size_t pos = start;
+        // Word alternatives in their regex order. The optional prefix and U* are
+        // greedy, so backtrack U* only when needed to make the required L+ match.
+        auto word = [&](size_t at, bool require_lower) -> size_t {
+            const bool prefix = cpts[at] != '\r' && cpts[at] != '\n' &&
+                                !(flags[at] & (TEKKEN_LETTER | TEKKEN_NUMBER));
+            for (int attempt = 0; attempt < (prefix ? 2 : 1); ++attempt) {
+                const size_t first = at + (prefix && attempt == 0 ? 1 : 0);
+                size_t cursor = first;
+                while (cursor < limit && (flags[cursor] & TEKKEN_UPPER_GROUP)) {
+                    ++cursor;
+                }
+                if (require_lower) {
+                    while (!(cursor < limit && (flags[cursor] & TEKKEN_LOWER_GROUP))) {
+                        if (cursor == first) {
+                            break;
+                        }
+                        --cursor;
+                    }
+                    if (cursor >= limit || !(flags[cursor] & TEKKEN_LOWER_GROUP)) {
+                        continue;
+                    }
+                } else if (cursor == first) {
+                    continue;
+                }
+                while (cursor < limit && (flags[cursor] & TEKKEN_LOWER_GROUP)) {
+                    ++cursor;
+                }
+                return cursor;
+            }
+            return at;
+        };
+        while (pos < limit) {
+            size_t next = word(pos, true); // [^\r\n\p{L}\p{N}]? U* L+
+            if (next == pos) {
+                next = word(pos, false);   // [^\r\n\p{L}\p{N}]? U+ L*
+            }
+            if (next == pos && (flags[pos] & TEKKEN_NUMBER)) {
+                next = pos + 1; // \p{N}
+            }
+            if (next == pos) {
+                //  ?[^\s\p{L}\p{N}]+[\r\n/]*
+                const size_t first = pos + (cpts[pos] == ' ' ? 1 : 0);
+                size_t cursor = first;
+                while (cursor < limit &&
+                       !(flags[cursor] & (TEKKEN_WHITESPACE | TEKKEN_LETTER | TEKKEN_NUMBER))) {
+                    ++cursor;
+                }
+                if (cursor > first) {
+                    while (cursor < limit && (cpts[cursor] == '\r' || cpts[cursor] == '\n' || cpts[cursor] == '/')) {
+                        ++cursor;
+                    }
+                    next = cursor;
+                }
+            }
+            if (next == pos && (flags[pos] & TEKKEN_WHITESPACE)) {
+                size_t cursor = pos;
+                size_t last_newline_end = pos;
+                while (cursor < limit && (flags[cursor] & TEKKEN_WHITESPACE)) {
+                    if (cpts[cursor] == '\r' || cpts[cursor] == '\n') {
+                        last_newline_end = cursor + 1;
+                    }
+                    ++cursor;
+                }
+                if (last_newline_end > pos) {
+                    next = last_newline_end; // \s*[\r\n]+
+                } else if (cursor == limit) {
+                    next = cursor;          // \s+(?!\S), at end
+                } else if (cursor > pos + 1) {
+                    next = cursor - 1;      // \s+(?!\S), greedy backtrack
+                } else {
+                    next = cursor;          // \s+
+                }
+            }
+            // Every Unicode scalar matches an alternative. No silent fallback:
+            // an invalid classifier/regex update must not drop input.
+            assert(next > pos && next <= limit);
+            result.push_back(next - pos);
+            pos = next;
+        }
+        start = limit;
+    }
+    assert(start == cpts.size());
+    return result;
+}
